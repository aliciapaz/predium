<dialog data-controller="conflict-dialog"
        data-action="predium:conflict@document->conflict-dialog#open"
        class="w-full max-w-md p-0 text-ink bg-surface border border-line rounded-xl shadow-pop backdrop:bg-ink/40">
  <div class="p-5 sm:p-6">
    <h2 class="section-title mb-2"><%= t("offline.conflict_title") %></h2>
    <p class="text-ink-soft mb-4"><%= t("offline.conflict_body") %></p>

    <dl class="space-y-2 mb-6">
      <div class="flex justify-between gap-4">
        <dt class="text-muted"><%= t("offline.conflict_yours") %></dt>
        <dd class="font-semibold text-ink" data-conflict-dialog-target="localTime"></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-muted"><%= t("offline.conflict_server") %></dt>
        <dd class="font-semibold text-ink" data-conflict-dialog-target="serverTime"></dd>
      </div>
    </dl>

    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <button type="button" data-action="conflict-dialog#takeServer" class="btn-secondary">
        <%= t("offline.conflict_take_server") %>
      </button>
      <button type="button" data-action="conflict-dialog#keepMine" class="btn-primary">
        <%= t("offline.conflict_keep_mine") %>
      </button>
    </div>
  </div>
</dialog>
