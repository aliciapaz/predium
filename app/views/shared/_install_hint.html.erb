<div class="max-w-5xl w-full mx-auto px-4 pt-4" data-controller="install-hint" hidden>
  <%= alert_box tone: :warning do %>
    <div class="flex items-start justify-between gap-3">
      <p><%= t("offline.install_hint") %></p>
      <%= icon_button :close, label: t("offline.install_hint_dismiss"), class: "-mt-2 -mr-2", data: { action: "install-hint#dismiss" } %>
    </div>
  <% end %>
</div>
