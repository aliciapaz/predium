<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <div class="max-w-5xl w-full mx-auto px-4 pt-4" data-controller="dismissible">
    <%= alert_box tone: (type.to_s == "notice" ? :success : :danger) do %>
      <div class="flex items-start justify-between gap-2">
        <p class="pt-0.5"><%= message %></p>
        <%= icon_button :close, label: t("common.dismiss"), class: "-my-2.5 -mr-2.5 text-current",
            data: { action: "dismissible#dismiss" } %>
      </div>
    <% end %>
  </div>
<% end %>
