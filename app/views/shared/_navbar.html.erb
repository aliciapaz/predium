<nav class="app-bar" data-controller="navbar" aria-label="<%= t("nav.main") %>">
  <div class="max-w-5xl mx-auto px-4 flex items-center gap-3 h-16">
    <%= link_to root_path, class: "app-brand" do %>
      <%= image_tag "/favicon.svg", alt: "", width: 30, height: 30 %>
      <span>Predium</span>
    <% end %>

    <div class="hidden md:flex items-center gap-1 ml-4">
      <%= nav_link t("nav.my_forms"), root_path %>
      <%= render "shared/organization_nav_link" %>
      <%= nav_link t("nav.profile"), profile_path %>
      <% if current_user.super_admin? %>
        <%= nav_link t("nav.admin"), admin_root_path %>
      <% end %>
    </div>

    <div class="ml-auto flex items-center gap-2">
      <%= render "shared/sync_status" %>

      <div class="hidden md:flex items-center gap-3">
        <%= render "shared/locale_switch" %>
        <span class="text-sm font-semibold text-ink-soft"><%= current_user.first_name %></span>
        <%= button_to t("nav.sign_out"), destroy_user_session_path, method: :delete, class: "btn-quiet",
            form: { data: { controller: "sign-out", action: "submit->sign-out#confirm", sign_out_message_value: t("nav.sign_out_pending") } } %>
      </div>

      <%= icon_button :menu, label: t("nav.menu"), class: "md:hidden",
          "aria-expanded": "false", "aria-controls": "app-menu",
          data: { action: "navbar#toggle", navbar_target: "button" } %>
    </div>
  </div>

  <div id="app-menu" class="md:hidden hidden border-t border-line bg-surface" data-navbar-target="menu">
    <div class="px-4 py-3 flex flex-col gap-1">
      <%= nav_link t("nav.my_forms"), root_path, css: "app-nav-link-row" %>
      <%= render "shared/organization_nav_link", css: "app-nav-link-row" %>
      <%= nav_link t("nav.profile"), profile_path, css: "app-nav-link-row" %>
      <% if current_user.super_admin? %>
        <%= nav_link t("nav.admin"), admin_root_path, css: "app-nav-link-row" %>
      <% end %>

      <div class="mt-2 pt-3 border-t border-line-soft flex items-center justify-between gap-3">
        <%= render "shared/locale_switch" %>
        <%= button_to t("nav.sign_out"), destroy_user_session_path, method: :delete, class: "btn-secondary",
            form: { data: { controller: "sign-out", action: "submit->sign-out#confirm", sign_out_message_value: t("nav.sign_out_pending") } } %>
      </div>
    </div>
  </div>
</nav>
