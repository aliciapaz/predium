<div class="flex flex-col items-center text-center gap-3 px-6 py-10 rounded-xl border-2 border-dashed border-line">
  <span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-sunken text-muted">
    <%= icon(:document, css: "w-6 h-6") %>
  </span>
  <p class="text-ink-soft max-w-xs"><%= message %></p>
  <% if local_assigns[:action_text] && local_assigns[:action_path] %>
    <%= link_to local_assigns[:action_path], class: "btn-secondary mt-1" do %>
      <%= icon(:plus) %>
      <%= local_assigns[:action_text] %>
    <% end %>
  <% end %>
</div>
