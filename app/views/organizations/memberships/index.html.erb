<% content_for(:title, "#{t('navigation.members')} | #{@organization.name}") %>

<% current_membership = current_user.memberships.find_by(organization: @organization) %>
<% is_admin = current_membership&.admin? %>

<div>
  <%= page_header("#{t('navigation.members')}: #{@organization.name}") do %>
    <div class="flex items-center gap-3">
      <%= badge(@memberships.size, tone: :neutral) %>
      <% if is_admin %>
        <%= link_to t("labels.invite_member"), new_organization_invitation_path(@organization), class: "btn-primary" %>
      <% end %>
    </div>
  <% end %>

  <div class="card-flush overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col"><%= t("labels.name") %></th>
          <th scope="col"><%= t("labels.email") %></th>
          <th scope="col"><%= t("labels.role") %></th>
          <th scope="col"><%= t("labels.joined") %></th>
          <% if is_admin %>
            <th scope="col" class="text-right"><%= t("labels.actions") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @memberships.each do |membership| %>
          <tr>
            <td><%= membership.user.first_name %> <%= membership.user.last_name %></td>
            <td><%= membership.user.email %></td>
            <td><%= badge(t("roles.#{membership.role}"), tone: membership.admin? ? :success : :neutral) %></td>
            <td><%= membership.created_at.strftime("%b %d, %Y") %></td>
            <% if is_admin %>
              <td class="text-right">
                <% unless membership.user == current_user %>
                  <%= button_to t("labels.remove"),
                      organization_membership_path(@organization, membership),
                      method: :delete,
                      data: { turbo_confirm: t("common.confirm_delete") },
                      class: "btn-danger btn-compact" %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
