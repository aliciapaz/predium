<% content_for(:title, "#{t('navigation.members')} | #{@organization.name}") %>

<% is_admin = allowed_to?(:manage?, @organization) %>

<div>
  <%= page_header(@organization.name) do %>
    <% if is_admin %>
      <%= link_to new_organization_invitation_path(@organization), class: "btn-primary" do %>
        <%= icon(:plus) %>
        <%= t("labels.invite_member") %>
      <% end %>
    <% end %>
  <% end %>
  <%= render "organizations/tabs", organization: @organization %>

  <div class="card-flush overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col"><%= t("labels.name") %></th>
          <th scope="col"><%= t("labels.email") %></th>
          <th scope="col"><%= t("labels.role") %></th>
          <th scope="col"><%= t("labels.joined") %></th>
          <% if is_admin %>
            <th scope="col" class="text-right"><%= t("labels.actions") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @memberships.each do |membership| %>
          <tr>
            <td><%= membership.user.first_name %> <%= membership.user.last_name %></td>
            <td><%= membership.user.email %></td>
            <td><%= badge(t("roles.#{membership.role}"), tone: membership.admin? ? :success : :neutral) %></td>
            <td><%= l(membership.created_at, format: :short) %></td>
            <% if is_admin %>
              <td class="text-right">
                <% unless membership.user == current_user %>
                  <% member_name = [membership.user.first_name, membership.user.last_name].compact_blank.join(" ").presence || membership.user.email %>
                  <%= button_to t("labels.remove"),
                      organization_membership_path(@organization, membership),
                      method: :delete,
                      "aria-label": t("labels.remove_member", name: member_name),
                      data: { turbo_confirm: t("labels.confirm_remove_member", name: member_name, org: @organization.name) },
                      class: "btn-danger btn-compact" %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
