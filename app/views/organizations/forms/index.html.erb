<% content_for(:title, "#{@organization.name} | #{t('navigation.forms')}") %>

<div>
  <%= page_header(@organization.name) %>
  <%= render "organizations/tabs", organization: @organization %>

  <div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="segmented" role="group" aria-label="<%= t("labels.status") %>">
        <%= link_to t("labels.all"), organization_forms_path(@organization), "aria-current": ("true" if params[:state].blank?) %>
        <%= link_to t("states.draft"), organization_forms_path(@organization, state: "draft"), "aria-current": ("true" if params[:state] == "draft") %>
        <%= link_to t("states.completed"), organization_forms_path(@organization, state: "completed"), "aria-current": ("true" if params[:state] == "completed") %>
      </div>
      <%= badge("#{t('common.total')}: #{@forms.size}", tone: :neutral) %>
    </div>

    <turbo-frame id="org_forms_search">
      <%= form_with url: organization_forms_path(@organization), method: :get, data: { turbo_frame: "org_forms_results" } do |f| %>
        <div class="flex items-center gap-3">
          <%= f.text_field :search, value: params[:search], placeholder: t("labels.search_farm"), class: "flex-1 min-w-0" %>
          <%= f.hidden_field :state, value: params[:state] %>
          <%= f.submit t("labels.search") %>
        </div>
      <% end %>
    </turbo-frame>

    <turbo-frame id="org_forms_results">
      <% if @forms.any? %>
        <div class="card-flush overflow-x-auto">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col"><%= t("labels.name") %></th>
                <th scope="col"><%= t("labels.farm_name") %></th>
                <th scope="col"><%= t("labels.status") %></th>
                <th scope="col"><%= t("labels.location") %></th>
                <th scope="col"><%= t("labels.date") %></th>
              </tr>
            </thead>
            <tbody>
              <% @forms.each do |form| %>
                <tr>
                  <td><%= form.user.first_name %> <%= form.user.last_name %></td>
                  <td>
                    <%= link_to form.name, form_path(form), class: "link" %>
                  </td>
                  <td>
                    <%= badge(t("states.#{form.state}"), tone: form.state == "completed" ? :success : :warning) %>
                  </td>
                  <td><%= [form.locality, form.region].compact_blank.join(", ").presence || "-" %></td>
                  <td class="text-muted"><%= form_date(form) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <%= render "shared/empty_state", message: t("common.no_results") %>
      <% end %>
    </turbo-frame>
  </div>
</div>
