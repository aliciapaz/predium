<% content_for(:title, t("labels.invite_member")) %>

<div class="max-w-lg mx-auto">
  <%= page_header(t("labels.invite_to_org", org: @organization.name), back: [t("buttons.back"), organization_memberships_path(@organization)]) %>

  <div class="card">
    <%= form_with url: organization_invitations_path(@organization), scope: :invitation, method: :post, class: "flex flex-col gap-5" do |f| %>
      <div>
        <%= f.label :email, t("labels.email") %>
        <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", inputmode: "email",
            placeholder: "user@example.com" %>
      </div>

      <div>
        <%= f.label :role, t("labels.role") %>
        <%= f.select :role, [[t("roles.member"), "member"], [t("roles.admin"), "admin"]] %>
      </div>

      <div class="flex flex-col-reverse gap-3 pt-2 sm:flex-row sm:justify-end">
        <%= link_to t("buttons.cancel"), organization_memberships_path(@organization), class: "btn-quiet" %>
        <%= f.submit t("labels.send_invitation") %>
      </div>
    <% end %>
  </div>
</div>
