<%# locals: (title:, value:, subtitle: nil) %>
<div class="card min-w-0">
  <p class="font-display text-2xl sm:text-3xl font-bold text-ink break-words"><%= value %></p>
  <p class="mt-1 text-ink-soft"><%= title %></p>
  <% if subtitle.present? %>
    <p class="mt-1 text-sm text-muted"><%= subtitle %></p>
  <% end %>
</div>
