<% content_for(:page_title, t("admin.dashboard")) %>

<div>
  <%= page_header(t("admin.dashboard")) %>

  <div class="flex flex-col gap-6">
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
      <%= render "admin/shared/stat_card", title: t("admin.total_users"), value: @report.total_users %>
      <%= render "admin/shared/stat_card", title: t("admin.total_organizations"), value: @report.total_organizations %>
      <%= render "admin/shared/stat_card", title: t("admin.completed_forms"), value: @report.completed_forms %>
      <%= render "admin/shared/stat_card", title: t("admin.draft_forms"), value: @report.draft_forms %>
      <%= render "admin/shared/stat_card", title: t("admin.countries_active"), value: @report.countries.size %>
    </div>

    <%= form_with url: admin_root_path, method: :get, class: "card" do %>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:items-end">
        <%= labeled_field(id: "country", name: "country", label: t("admin.filter_country"), as: :select,
              options: [[t("admin.filter_all_countries"), ""]] + @report.countries.map { |country| [country, country] },
              value: params[:country]) %>
        <%= labeled_field(id: "date_from", name: "date_from", label: t("admin.filter_from"), type: "date", value: params[:date_from]) %>
        <%= labeled_field(id: "date_to", name: "date_to", label: t("admin.filter_to"), type: "date", value: params[:date_to]) %>
        <button type="submit" class="btn-primary"><%= t("admin.filter_apply") %></button>
      </div>
    <% end %>

    <section class="card-flush">
      <h2 class="section-title px-4 py-4 border-b border-line"><%= t("admin.recent_activity") %></h2>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col"><%= t("admin.table_farm_name") %></th>
              <th scope="col"><%= t("admin.table_user") %></th>
              <th scope="col"><%= t("admin.table_country") %></th>
              <th scope="col"><%= t("admin.table_region") %></th>
              <th scope="col"><%= t("admin.table_completed") %></th>
            </tr>
          </thead>
          <tbody>
            <% @report.recent_forms.each do |form| %>
              <tr>
                <td>
                  <%= link_to form.name, admin_form_path(form), class: "link" %>
                </td>
                <td>
                  <%= form.user.first_name %> <%= form.user.last_name %>
                </td>
                <td><%= form.country %></td>
                <td><%= form.region %></td>
                <td><%= format_admin_date(form.completed_at) %></td>
              </tr>
            <% end %>
            <% if @report.recent_forms.empty? %>
              <tr>
                <td colspan="5" class="py-8 text-center text-muted"><%= t("admin.no_completed_forms") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
