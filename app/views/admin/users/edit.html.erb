<% content_for(:page_title, t("admin.edit_user_role")) %>

<div>
  <%= page_header("#{t("admin.edit_user_role")}: #{@user.first_name} #{@user.last_name}", back: [t("buttons.back"), admin_user_path(@user)]) %>

  <div class="max-w-lg">
    <div class="card">
      <%= form_with model: [:admin, @user], class: "flex flex-col gap-5" do |f| %>
        <div>
          <%= f.label :platform_role, t("admin.platform_role") %>
          <%= f.select :platform_role, User.platform_roles.keys.map { |r| [t("roles.#{r}"), r] } %>
        </div>

        <%= alert_box t("admin.role_warning"), tone: :warning %>

        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
          <%= link_to t("buttons.cancel"), admin_user_path(@user), class: "btn-quiet" %>
          <%= f.submit t("admin.update_role") %>
        </div>
      <% end %>
    </div>
  </div>
</div>
