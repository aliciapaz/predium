<% content_for(:page_title, "#{@user.first_name} #{@user.last_name}") %>

<div>
  <%= page_header("#{@user.first_name} #{@user.last_name}", back: [t("admin.back_to_users"), admin_users_path], subtitle: @user.email) do %>
    <div class="flex items-center gap-3">
      <%= role_badge(@user.platform_role) %>
      <%= link_to t("admin.edit_role"), edit_admin_user_path(@user), class: "btn-secondary" %>
    </div>
  <% end %>

  <div class="flex flex-col gap-6">
    <section class="card">
      <h2 class="section-title mb-4"><%= t("admin.profile") %></h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <dt class="text-sm text-muted"><%= t("admin.phone") %></dt>
          <dd class="mt-1 text-ink"><%= @user.profile&.phone || "-" %></dd>
        </div>
        <div>
          <dt class="text-sm text-muted"><%= t("admin.professional_role") %></dt>
          <dd class="mt-1 text-ink"><%= @user.profile&.role_name || "-" %></dd>
        </div>
        <div>
          <dt class="text-sm text-muted"><%= t("admin.table_country") %></dt>
          <dd class="mt-1 text-ink"><%= @user.profile&.country || "-" %></dd>
        </div>
        <div>
          <dt class="text-sm text-muted"><%= t("admin.table_region") %></dt>
          <dd class="mt-1 text-ink"><%= @user.profile&.region || "-" %></dd>
        </div>
      </dl>
    </section>

    <section class="card-flush">
      <h2 class="section-title px-4 py-4 border-b border-line"><%= t("admin.organizations") %></h2>
      <% if @memberships.any? %>
        <ul class="divide-y divide-line-soft">
          <% @memberships.each do |membership| %>
            <li class="px-4 min-h-14 py-2 flex items-center justify-between gap-3">
              <span class="font-semibold text-ink"><%= membership.organization.name %></span>
              <%= role_badge(membership.role) %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-4 py-8 text-center text-muted"><%= t("admin.no_organizations") %></p>
      <% end %>
    </section>

    <section class="card-flush">
      <h2 class="section-title px-4 py-4 border-b border-line"><%= t("admin.recent_forms") %></h2>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col"><%= t("admin.table_farm_name") %></th>
              <th scope="col"><%= t("admin.table_state") %></th>
              <th scope="col"><%= t("admin.table_country") %></th>
              <th scope="col"><%= t("admin.table_created") %></th>
            </tr>
          </thead>
          <tbody>
            <% @recent_forms.each do |form| %>
              <tr>
                <td>
                  <%= link_to form.name, admin_form_path(form), class: "link" %>
                </td>
                <td><%= badge(form.state.titleize, tone: form.completed? ? :success : :warning) %></td>
                <td><%= form.country %></td>
                <td><%= format_admin_date(form.created_at) %></td>
              </tr>
            <% end %>
            <% if @recent_forms.empty? %>
              <tr>
                <td colspan="4" class="py-8 text-center text-muted"><%= t("admin.no_forms") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
