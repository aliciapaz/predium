<% content_for(:page_title, t("admin.users")) %>

<div>
  <%= page_header(t("admin.users")) do %>
    <%= badge(@users.size, tone: :neutral) %>
  <% end %>

  <div class="flex flex-col gap-6">
    <%= form_with url: admin_users_path, method: :get, class: "card" do %>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
        <%= labeled_field(id: "q", name: "q", label: t("admin.search_users"), value: params[:q],
              placeholder: t("admin.search_placeholder"), wrapper: "flex-1") %>
        <button type="submit" class="btn-primary"><%= t("admin.search") %></button>
      </div>
    <% end %>

    <div class="card-flush overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col"><%= t("admin.table_name") %></th>
            <th scope="col"><%= t("admin.table_email") %></th>
            <th scope="col"><%= t("admin.table_role") %></th>
            <th scope="col"><%= t("admin.table_organizations") %></th>
            <th scope="col"><%= t("admin.table_forms") %></th>
            <th scope="col"><%= t("admin.table_joined") %></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <%= link_to "#{user.first_name} #{user.last_name}", admin_user_path(user), class: "link" %>
              </td>
              <td><%= user.email %></td>
              <td>
                <div class="flex flex-wrap gap-2">
                  <%= role_badge(user.platform_role) %>
                  <% user.memberships.each do |membership| %>
                    <%= role_badge(membership.role, organization: membership.organization) %>
                  <% end %>
                </div>
              </td>
              <td><%= user.organizations.size %></td>
              <td><%= user.forms.size %></td>
              <td><%= format_admin_date(user.created_at) %></td>
            </tr>
          <% end %>
          <% if @users.empty? %>
            <tr>
              <td colspan="6" class="py-8 text-center text-muted"><%= t("admin.no_users") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
