<%# locals: (organization:) %>
<div class="max-w-lg">
  <div class="card">
    <%= form_with model: [:admin, organization], class: "flex flex-col gap-5" do |f| %>
      <% if organization.errors.any? %>
        <%= alert_box tone: :danger do %>
          <ul class="list-disc list-inside">
            <% organization.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <div>
        <%= f.label :name, t("admin.org_name") %>
        <%= f.text_field :name, placeholder: t("admin.org_name_placeholder") %>
      </div>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= link_to t("buttons.cancel"), admin_organizations_path, class: "btn-quiet" %>
        <%= f.submit organization.persisted? ? t("admin.update_organization") : t("admin.create_organization") %>
      </div>
    <% end %>
  </div>
</div>
