<% content_for(:page_title, @organization.name) %>

<div>
  <%= page_header(@organization.name, back: [t("buttons.back"), admin_organizations_path]) do %>
    <%= link_to t("navigation.members"), organization_memberships_path(@organization), class: "btn-secondary" %>
    <%= link_to t("buttons.edit"), edit_admin_organization_path(@organization), class: "btn-secondary" %>
  <% end %>

  <div class="flex flex-col gap-6">
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
      <%= render "admin/shared/stat_card", title: t("admin.members"), value: @members.size %>
      <%= render "admin/shared/stat_card", title: t("admin.forms"), value: @forms_count %>
      <%= render "admin/shared/stat_card", title: t("admin.table_created"), value: format_admin_date(@organization.created_at) %>
    </div>

    <section class="card-flush">
      <h2 class="section-title px-4 py-4 border-b border-line"><%= t("admin.members") %></h2>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col"><%= t("admin.table_name") %></th>
              <th scope="col"><%= t("admin.table_email") %></th>
              <th scope="col"><%= t("admin.table_role") %></th>
              <th scope="col"><%= t("admin.table_joined") %></th>
            </tr>
          </thead>
          <tbody>
            <% @members.each do |membership| %>
              <tr>
                <td>
                  <%= link_to "#{membership.user.first_name} #{membership.user.last_name}",
                      admin_user_path(membership.user), class: "link" %>
                </td>
                <td><%= membership.user.email %></td>
                <td><%= role_badge(membership.role) %></td>
                <td><%= format_admin_date(membership.created_at) %></td>
              </tr>
            <% end %>
            <% if @members.empty? %>
              <tr>
                <td colspan="4" class="py-8 text-center text-muted"><%= t("admin.no_members") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card-flush">
      <h2 class="section-title px-4 py-4 border-b border-line"><%= t("admin.recent_forms") %></h2>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col"><%= t("admin.table_farm_name") %></th>
              <th scope="col"><%= t("admin.table_user") %></th>
              <th scope="col"><%= t("admin.table_state") %></th>
              <th scope="col"><%= t("admin.table_completed") %></th>
            </tr>
          </thead>
          <tbody>
            <% @recent_forms.each do |form| %>
              <tr>
                <td>
                  <%= link_to form.name, form_path(form), class: "link" %>
                </td>
                <td>
                  <%= form.user.first_name %> <%= form.user.last_name %>
                </td>
                <td><%= badge(form.state.titleize, tone: form.completed? ? :success : :warning) %></td>
                <td><%= format_admin_date(form.completed_at) %></td>
              </tr>
            <% end %>
            <% if @recent_forms.empty? %>
              <tr>
                <td colspan="4" class="py-8 text-center text-muted"><%= t("admin.no_forms") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
