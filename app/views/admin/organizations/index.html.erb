<% content_for(:page_title, t("admin.organizations")) %>

<div>
  <%= page_header(t("admin.organizations")) do %>
    <div class="flex items-center gap-3">
      <%= badge(@organizations.length, tone: :neutral) %>
      <%= link_to t("admin.new_organization"), new_admin_organization_path, class: "btn-primary" %>
    </div>
  <% end %>

  <div class="card-flush overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.table_name") %></th>
          <th scope="col"><%= t("admin.table_members") %></th>
          <th scope="col"><%= t("admin.table_created") %></th>
          <th scope="col" class="text-right"><%= t("labels.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @organizations.each do |org| %>
          <tr>
            <td><%= org.name %></td>
            <td><%= org.members_count %></td>
            <td><%= format_admin_date(org.created_at) %></td>
            <td>
              <div class="flex items-center justify-end gap-2">
                <%= link_to t("admin.view"), admin_organization_path(org), class: "btn-quiet btn-compact" %>
                <%= link_to t("buttons.edit"), edit_admin_organization_path(org), class: "btn-quiet btn-compact" %>
                <%= button_to t("buttons.delete"), admin_organization_path(org), method: :delete,
                    class: "btn-danger btn-compact",
                    data: { turbo_confirm: t("admin.confirm_delete_org") } %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @organizations.empty? %>
          <tr>
            <td colspan="4" class="py-8 text-center text-muted"><%= t("admin.no_organizations") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
