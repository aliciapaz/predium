<%# Field errors render under their control (PrediumFormBuilder); this lists only errors with no visible control, such as a bad reset link. %>
<% messages = resource.errors.select { |error| error.attribute == :base || error.attribute.end_with?("_token") }.map { |error| error.message.upcase_first } %>
<% if messages.any? %>
  <%= alert_box tone: :danger, data: { turbo_temporary: true } do %>
    <% messages.each do |message| %>
      <p><%= message %></p>
    <% end %>
  <% end %>
<% end %>
