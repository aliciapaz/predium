<div class="mt-6 flex flex-col items-center">
  <%- if controller_name != "sessions" %>
    <%= link_to t("devise_views.log_in_link"), new_user_session_path, class: "link inline-flex items-center min-h-11" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to t("devise_views.sign_up_link"), new_user_registration_path, class: "link inline-flex items-center min-h-11" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to t("devise_views.forgot_password_link"), new_user_password_path, class: "link inline-flex items-center min-h-11" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != "confirmations" %>
    <%= link_to t("devise_views.no_confirmation_link"), new_user_confirmation_path, class: "link inline-flex items-center min-h-11" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != "unlocks" %>
    <%= link_to t("devise_views.no_unlock_link"), new_user_unlock_path, class: "link inline-flex items-center min-h-11" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Sign in with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "link inline-flex items-center min-h-11" %>
    <% end %>
  <% end %>
</div>
