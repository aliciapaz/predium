<div class="auth-panel">
  <div class="text-center mb-8">
    <%= image_tag "/favicon.svg", alt: "", width: 56, height: 56, class: "mx-auto mb-4" %>
    <h1 class="page-title">Predium</h1>
    <p class="mt-2 text-ink-soft"><%= t("devise_views.resend_unlock_subtitle") %></p>
  </div>

  <div class="card">
    <%= form_for(resource, as: resource_name, url: user_unlock_path, html: { method: :post, class: "flex flex-col gap-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", inputmode: "email" %>
      </div>

      <%= f.submit t("devise_views.resend_unlock_button"), class: "w-full" %>
    <% end %>
  </div>

  <%= render "devise/shared/links" %>
</div>
