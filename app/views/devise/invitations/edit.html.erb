<div class="auth-panel">
  <div class="text-center mb-8">
    <%= image_tag "/favicon.svg", alt: "", width: 56, height: 56, class: "mx-auto mb-4" %>
    <h1 class="page-title">Predium</h1>
    <p class="mt-2 text-ink-soft"><%= t("devise.invitations.edit.header") %></p>
  </div>

  <div class="card">
    <%= form_for(resource, as: resource_name, url: user_invitation_path, html: { method: :put, class: "flex flex-col gap-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.hidden_field :invitation_token, readonly: true %>

      <% if f.object.class.require_password_on_accepting %>
        <div>
          <%= f.label :password %>
          <%= f.password_field :password, autocomplete: "new-password" %>
        </div>

        <div>
          <%= f.label :password_confirmation %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
        </div>
      <% end %>

      <%= f.submit t("devise.invitations.edit.submit_button"), class: "w-full" %>
    <% end %>
  </div>
</div>
