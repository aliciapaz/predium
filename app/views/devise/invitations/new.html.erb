<div class="max-w-md mx-auto">
  <%= page_header(t("devise.invitations.new.header")) %>

  <div class="card">
    <%= form_for(resource, as: resource_name, url: user_invitation_path, html: { method: :post, class: "flex flex-col gap-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>


      <% resource.class.invite_key_fields.each do |field| %>
        <div>
          <%= f.label field %>
          <%= f.text_field field %>
        </div>
      <% end %>

      <%= f.submit t("devise.invitations.new.submit_button"), class: "w-full" %>
    <% end %>
  </div>
</div>
