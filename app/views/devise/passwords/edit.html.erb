<div class="auth-panel">
  <div class="text-center mb-8">
    <%= image_tag "/favicon.svg", alt: "", width: 56, height: 56, class: "mx-auto mb-4" %>
    <h1 class="page-title">Predium</h1>
    <p class="mt-2 text-ink-soft"><%= t("devise_views.new_password_subtitle") %></p>
  </div>

  <div class="card">
    <%= form_for(resource, as: resource_name, url: user_password_path, html: { method: :put, class: "flex flex-col gap-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.hidden_field :reset_password_token %>

      <div>
        <%= f.label :password, t("devise_views.new_password") %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password" %>
        <% if @minimum_password_length %>
          <p class="field-hint"><%= t("devise_views.characters_minimum", count: @minimum_password_length) %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, t("devise_views.confirm_new_password") %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <%= f.submit t("devise_views.change_password_button"), class: "w-full" %>
    <% end %>
  </div>

  <%= render "devise/shared/links" %>
</div>
