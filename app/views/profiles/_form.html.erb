<%= form_with(model: profile, url: profile_path, method: :patch, class: "flex flex-col gap-5") do |f| %>
  <div>
    <%= f.label :phone, t("labels.phone") %>
    <%= f.text_field :phone, autocomplete: "tel", inputmode: "tel" %>
  </div>

  <div>
    <%= f.label :role_name, t("labels.professional_role") %>
    <%= f.text_field :role_name %>
  </div>

  <div>
    <%= f.label :country, t("labels.country") %>
    <%= f.text_field :country, autocomplete: "country-name" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :region, t("labels.region") %>
      <%= f.text_field :region %>
    </div>
    <div>
      <%= f.label :locality, t("labels.locality") %>
      <%= f.text_field :locality %>
    </div>
  </div>

  <%= labeled_field(id: "user_locale", name: "user[locale]", label: t("labels.locale"), as: :select,
        options: [["English", "en"], ["Español", "es"]], value: current_user.locale) %>

  <div class="flex flex-col-reverse gap-3 pt-2 sm:flex-row sm:justify-end">
    <%= link_to t("buttons.cancel"), profile_path, class: "btn-quiet" %>
    <%= f.submit t("buttons.save") %>
  </div>
<% end %>
