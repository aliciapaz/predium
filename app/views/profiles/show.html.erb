<% content_for(:title, t("nav.profile")) %>

<div class="max-w-3xl mx-auto">
  <%= page_header(t("titles.profile_show")) do %>
    <%= link_to t("buttons.edit"), edit_profile_path, class: "btn-secondary" %>
  <% end %>

  <div class="flex flex-col gap-6">
    <section class="card">
      <h2 class="section-title mb-4"><%= t("labels.user_info") %></h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
        <div>
          <dt class="text-sm text-muted"><%= t("labels.name") %></dt>
          <dd class="mt-1 text-ink font-semibold"><%= current_user.first_name %> <%= current_user.last_name %></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-sm text-muted"><%= t("labels.email") %></dt>
          <dd class="mt-1 text-ink break-words"><%= current_user.email %></dd>
        </div>
        <div>
          <dt class="text-sm text-muted"><%= t("labels.locale") %></dt>
          <dd class="mt-1 text-ink"><%= current_user.locale == "es" ? "Español" : "English" %></dd>
        </div>
      </dl>
    </section>

    <section class="card">
      <h2 class="section-title mb-4"><%= t("labels.profile_info") %></h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
        <div>
          <dt class="text-sm text-muted"><%= t("labels.phone") %></dt>
          <dd class="mt-1 text-ink"><%= @profile.phone.presence || "-" %></dd>
        </div>
        <div>
          <dt class="text-sm text-muted"><%= t("labels.professional_role") %></dt>
          <dd class="mt-1 text-ink"><%= @profile.role_name.presence || "-" %></dd>
        </div>
        <div>
          <dt class="text-sm text-muted"><%= t("labels.country") %></dt>
          <dd class="mt-1 text-ink"><%= @profile.country.presence || "-" %></dd>
        </div>
        <div>
          <dt class="text-sm text-muted"><%= t("labels.region") %></dt>
          <dd class="mt-1 text-ink"><%= @profile.region.presence || "-" %></dd>
        </div>
        <div>
          <dt class="text-sm text-muted"><%= t("labels.locality") %></dt>
          <dd class="mt-1 text-ink"><%= @profile.locality.presence || "-" %></dd>
        </div>
      </dl>
    </section>

    <section class="card">
      <h2 class="section-title mb-2"><%= t("navigation.organizations") %></h2>
      <% memberships = current_user.memberships.includes(:organization) %>
      <% if memberships.any? %>
        <ul class="divide-y divide-line-soft">
          <% memberships.each do |membership| %>
            <li class="min-h-14 py-2 flex items-center justify-between gap-3">
              <%= link_to membership.organization.name, organization_forms_path(membership.organization), class: "link" %>
              <%= badge(t("roles.#{membership.role}"), tone: membership.admin? ? :success : :neutral) %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted"><%= t("common.no_results") %></p>
      <% end %>
    </section>
  </div>
</div>
