<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Admin - Predium" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% if user_signed_in? %>
      <meta name="predium-signed-in" content="true">
      <meta name="predium-user" content="<%= current_user.id %>">
    <% end %>

    <%= yield :head %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-canvas text-ink min-h-dvh flex" data-controller="admin-sidebar">
    <div data-admin-sidebar-target="overlay" data-action="click->admin-sidebar#close"
         class="hidden fixed inset-0 bg-ink/50 z-40 md:hidden"></div>

    <aside data-admin-sidebar-target="sidebar"
           class="hidden md:flex w-56 bg-deep text-deep-ink min-h-dvh flex-col flex-shrink-0 fixed inset-y-0 left-0 md:static z-50 transition-transform duration-200 -translate-x-full md:translate-x-0">
      <div class="px-4 pb-5 safe-top">
        <h1 class="font-display text-lg font-bold tracking-tight"><%= t("admin.predium_admin") %></h1>
      </div>

      <nav class="flex-1 px-2 space-y-1">
        <%= admin_sidebar_link t("admin.dashboard"), admin_root_path %>
        <%= admin_sidebar_link t("admin.organizations"), admin_organizations_path %>
        <%= admin_sidebar_link t("admin.users"), admin_users_path %>
      </nav>

      <div class="px-4 py-4 border-t border-deep-line">
        <%= link_to t("admin.back_to_app"), root_path, class: "inline-flex items-center min-h-11 font-semibold text-deep-soft hover:text-deep-ink transition-colors" %>
      </div>
    </aside>

    <div class="flex-1 min-w-0 flex flex-col min-h-dvh">
      <header class="app-bar">
        <div class="px-4 h-16 flex items-center gap-3">
          <%= icon_button :menu, label: t("nav.menu"), class: "md:hidden -ml-2",
              data: { action: "admin-sidebar#toggle" } %>
          <h2 class="flex-1 min-w-0 truncate font-semibold text-ink-soft"><%= yield :page_title %></h2>
          <span class="max-w-40 truncate text-sm font-semibold text-ink-soft"><%= current_user.first_name %> <%= current_user.last_name %></span>
        </div>
      </header>

      <%= render "shared/flash" %>

      <main class="flex-1 w-full max-w-6xl mx-auto px-4 pt-4 pb-8 sm:pt-8">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
