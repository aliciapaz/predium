<% content_for(:title, t("titles.form_show")) %>

<%# Results shell (KTD-4): farm info, scores, and charts hydrate client-side
    from IndexedDB via lib/scoring.js, so results render offline too. %>
<div class="max-w-2xl mx-auto flex flex-col gap-8" data-controller="results" data-results-client-id-value="<%= params[:id] %>">
  <div class="flex flex-col gap-4">
    <%= link_to forms_path, class: "back-link" do %>
      <%= icon(:chevron_left) %>
      <%= t("forms.back_to_forms") %>
    <% end %>

    <%= alert_box t("offline.results_unavailable"), tone: :warning, class: "hidden", data: { results_target: "missing" } %>

    <div data-results-target="farmInfo">
      <p class="text-muted"><%= t("offline.loading") %></p>
    </div>
  </div>

  <section>
    <h2 class="section-title mb-3"><%= t("results.category_overview") %></h2>
    <div class="card" data-results-target="radar"></div>
  </section>

  <section>
    <h2 class="section-title mb-3"><%= t("results.dimension_scores") %></h2>
    <div class="card-flush divide-y divide-line-soft" data-results-target="dimensions"></div>
  </section>

  <section>
    <h2 class="section-title mb-3"><%= t("results.all_indicators") %></h2>
    <div class="flex flex-col gap-3" data-results-target="indicators"></div>
  </section>

  <div class="flex flex-col-reverse sm:flex-row sm:items-center gap-3 pt-6 border-t border-line">
    <%= link_to t("forms.back_to_forms"), forms_path, class: "btn-quiet" %>
    <button type="button" class="btn-secondary sm:ml-auto" disabled><%= t("buttons.generate_pdf") %></button>
  </div>
</div>
