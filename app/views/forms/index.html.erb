<% content_for(:title, t("titles.forms_index")) %>

<div class="max-w-2xl mx-auto" data-controller="offline-forms">
  <%= page_header t("titles.forms_index") do %>
    <%= link_to new_form_path, class: "btn-primary" do %>
      <%= icon(:plus) %>
      <%= t("questionnaire.new_questionnaire") %>
    <% end %>
  <% end %>

  <div class="flex flex-col gap-10" data-offline-forms-target="list">
    <section>
      <div class="flex items-center gap-2 mb-4">
        <h2 class="section-title"><%= t("forms.drafts") %></h2>
        <%= badge(@drafts.size, tone: :warning) %>
      </div>

      <% if @drafts.any? %>
        <div class="flex flex-col gap-3">
          <%= render partial: "forms/form_card", collection: @drafts, as: :form %>
        </div>
      <% else %>
        <%= render "shared/empty_state",
            message: t("forms.no_drafts"),
            action_text: t("questionnaire.new_questionnaire"),
            action_path: new_form_path %>
      <% end %>
    </section>

    <section>
      <div class="flex items-center gap-2 mb-4">
        <h2 class="section-title"><%= t("forms.completed") %></h2>
        <%= badge(@completed.size, tone: :success) %>
      </div>

      <% if @completed.any? %>
        <div class="flex flex-col gap-3">
          <%= render partial: "forms/form_card", collection: @completed, as: :form %>
        </div>
      <% else %>
        <%= render "shared/empty_state", message: t("forms.no_completed") %>
      <% end %>
    </section>
  </div>
</div>
