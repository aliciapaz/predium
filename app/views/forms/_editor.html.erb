<%# Local-first editor shell (KTD-4): every input reads from and writes to
    IndexedDB via the form-editor controller. The server never renders form
    data here, so the same cached page works for any form, online or offline. %>
<div class="max-w-2xl mx-auto"
     data-controller="form-editor"
     data-form-editor-client-id-value="<%= client_id %>"
     data-form-editor-forms-url-value="<%= forms_path %>">

  <header class="page-header">
    <%= link_to forms_path, class: "back-link" do %>
      <%= icon(:chevron_left) %>
      <%= t("forms.back_to_forms") %>
    <% end %>
    <h1 class="page-title break-words" data-form-editor-target="title"><%= client_id.present? ? t("offline.loading") : t("questionnaire.new_questionnaire") %></h1>
    <p class="text-sm text-muted min-h-5" data-form-editor-target="saveState" aria-live="polite"></p>
  </header>

  <div class="mb-6">
    <div class="flex items-baseline justify-between gap-3 mb-2">
      <span class="text-sm font-semibold text-ink-soft"><%= t("questionnaire.overall_progress") %></span>
      <span class="text-sm font-semibold text-ink tabular-nums" data-form-editor-target="progressText"></span>
    </div>
    <div class="meter" role="presentation">
      <div class="meter-fill" data-form-editor-target="progressBar" style="width: 0%"></div>
    </div>
  </div>

  <details class="disclosure mb-8" data-form-editor-target="farmInfo" open>
    <summary>
      <span class="section-title"><%= t("farm_info.section_title") %></span>
      <span class="badge-neutral tabular-nums" data-form-editor-target="farmInfoCount"></span>
      <%= icon(:chevron_down, css: "disclosure-chevron") %>
    </summary>

    <div class="px-5 pt-5 pb-6 flex flex-col gap-8">
      <fieldset class="field-group">
        <legend><%= t("farm_info.farmer_information") %></legend>
        <%= labeled_field id: "farm_name", label: t("farm_info.farm_farmer_name"),
            placeholder: t("farm_info.placeholder_farm_name"), required: true,
            autocomplete: "off", data: { farm_field: "name" } %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-3 gap-y-5">
          <%= labeled_field id: "farm_national_id", label: t("farm_info.national_id"),
              autocomplete: "off", data: { farm_field: "national_id" } %>
          <%= labeled_field id: "farm_date_of_birth", label: t("farm_info.date_of_birth"), type: "date",
              data: { farm_field: "date_of_birth" } %>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-3 gap-y-5">
          <%= labeled_field id: "farm_phone", label: t("farm_info.phone"), type: "tel",
              inputmode: "tel", autocomplete: "off", data: { farm_field: "phone" } %>
          <%= labeled_field id: "farm_gender", label: t("farm_info.gender"), as: :select,
              options: [[t("farm_info.select_placeholder"), ""]] + Form.genders.keys.map { |gender| [t("farm_info.genders.#{gender}"), gender] },
              data: { farm_field: "gender" } %>
        </div>
      </fieldset>

      <fieldset class="field-group">
        <legend><%= t("farm_info.property") %></legend>
        <div class="grid grid-cols-2 gap-x-3 gap-y-5">
          <%= labeled_field id: "farm_work_force", label: t("farm_info.workforce_people"), type: "number",
              min: 0, inputmode: "numeric", data: { farm_field: "work_force" } %>
          <%= labeled_field id: "farm_land_area", label: t("farm_info.land_area_ha"), type: "number",
              min: 0, step: "0.01", inputmode: "decimal", data: { farm_field: "land_area" } %>
        </div>
        <div>
          <span class="field-label" id="system_types_label"><%= t("farm_info.system_types") %></span>
          <div class="flex flex-wrap gap-2" role="group" aria-labelledby="system_types_label">
            <% %w[agriculture livestock forestry agroforestry mixed].each do |sys| %>
              <label class="chip">
                <input type="checkbox" value="<%= sys %>" data-farm-field="system_types">
                <%= t("farm_info.system_#{sys}") %>
              </label>
            <% end %>
          </div>
        </div>
        <%= labeled_field id: "farm_observations", label: t("farm_info.observations"), as: :textarea,
            rows: 3, placeholder: t("farm_info.placeholder_observations"), data: { farm_field: "observations" } %>
      </fieldset>

      <fieldset class="field-group">
        <legend><%= t("farm_info.location") %></legend>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-3 gap-y-5">
          <%= labeled_field id: "farm_country", label: t("farm_info.country"), autocomplete: "off", data: { farm_field: "country" } %>
          <%= labeled_field id: "farm_region", label: t("farm_info.region"), autocomplete: "off", data: { farm_field: "region" } %>
          <%= labeled_field id: "farm_locality", label: t("farm_info.locality"), autocomplete: "off", data: { farm_field: "locality" } %>
        </div>
        <div class="flex flex-col gap-3" data-controller="geolocation">
          <div class="grid grid-cols-2 gap-3">
            <%= labeled_field id: "farm_latitude", label: t("farm_info.latitude"), type: "number", step: "0.000001",
                data: { farm_field: "latitude", geolocation_target: "latitude" } %>
            <%= labeled_field id: "farm_longitude", label: t("farm_info.longitude"), type: "number", step: "0.000001",
                data: { farm_field: "longitude", geolocation_target: "longitude" } %>
          </div>
          <button type="button" class="btn-secondary self-start" data-action="geolocation#locate" data-geolocation-target="button">
            <%= icon(:location) %>
            <span data-geolocation-target="label"><%= t("farm_info.use_gps") %></span>
          </button>
          <p class="field-error hidden" role="alert" data-geolocation-target="error"></p>
        </div>
        <%= labeled_field id: "farm_territory_key", label: t("farm_info.territory_extension"), as: :select,
            options: [[t("farm_info.select_placeholder"), ""]] + QuestionnaireConfig.extension_keys.map { |key| [key.humanize, key] },
            data: { farm_field: "territory_key" } %>
      </fieldset>
    </div>
  </details>

  <nav class="section-nav" data-form-editor-target="dimensionNav" aria-label="<%= t("questionnaire.overall_progress") %>"></nav>

  <div class="flex flex-col gap-5 mt-2" data-form-editor-target="indicators">
    <p class="text-muted"><%= t("offline.loading_questionnaire") %></p>
  </div>

  <div class="action-bar mt-10">
    <%= icon_button :chevron_left, label: t("questionnaire.previous_section"), class: "border-2 border-line-strong w-12 h-12 disabled:hidden",
        data: { form_editor_target: "prevButton", action: "form-editor#previousDimension" } %>

    <button type="button" class="btn-primary flex-1 min-w-0 justify-between text-left"
            data-form-editor-target="nextButton" data-action="form-editor#nextDimension">
      <span class="flex flex-col min-w-0">
        <span><%= t("questionnaire.next_section") %></span>
        <span class="text-sm font-normal opacity-85 truncate" data-form-editor-target="nextCaption"></span>
      </span>
      <%= icon(:chevron_right) %>
    </button>

    <%# The jump sits under the disabled button so the caption explaining why
        keeps its full width at 360px. %>
    <div class="flex-1 min-w-0 flex flex-col gap-1 hidden" data-form-editor-target="completeSlot">
      <%= form_with url: "#", method: :post, data: { form_editor_target: "completeForm" } do %>
        <button type="submit" class="btn-primary w-full hidden" data-form-editor-target="completeButton" disabled>
          <span class="flex flex-col min-w-0">
            <span><%= t("questionnaire.complete") %></span>
            <span class="text-sm font-normal truncate hidden" data-form-editor-target="completeHint"><%= t("offline.complete_requires_sync") %></span>
          </span>
        </button>
      <% end %>

      <button type="button" class="btn-quiet btn-compact hidden" data-form-editor-target="missingButton" data-action="form-editor#jumpToMissing">
        <%= t("questionnaire.go_to_missing") %>
        <%= icon(:chevron_right) %>
      </button>
    </div>
  </div>
</div>
