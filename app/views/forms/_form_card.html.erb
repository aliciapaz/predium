<%= turbo_frame_tag dom_id(form) do %>
  <% path = form.draft? ? edit_form_path(form) : form_path(form) %>
  <article class="card-flush overflow-hidden">
    <%= link_to path, data: { turbo_frame: "_top" }, class: "block px-5 pt-4 pb-3 hover:bg-canvas transition-colors" do %>
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-lg leading-snug min-w-0 break-words"><%= form.name %></h3>
        <%= badge(t("states.#{form.draft? ? "draft" : "completed"}"), tone: form.draft? ? :warning : :success) %>
      </div>

      <p class="mt-1 text-sm text-muted">
        <%= [[form.region, form.country].compact_blank.join(", ").presence, form_date(form)].compact.join(", ") %>
      </p>

      <% if form.draft? %>
        <% required = form.required_indicator_keys %>
        <% scored = (required & form.scored_keys).size %>
        <% pct = required.any? ? (scored * 100.0 / required.size).round : 0 %>
        <div class="mt-3 flex items-center gap-3">
          <div class="meter flex-1"><div class="meter-fill" style="width: <%= pct %>%"></div></div>
          <span class="text-sm font-semibold text-ink-soft tabular-nums whitespace-nowrap"><%= t("questionnaire.indicators_count", answered: scored, total: required.size) %></span>
        </div>
      <% end %>
    <% end %>

    <div class="flex items-center justify-between gap-2 px-2 py-1 border-t border-line-soft">
      <%= link_to path, data: { turbo_frame: "_top" }, class: "btn-quiet btn-compact" do %>
        <%= form.draft? ? t("questionnaire.continue") : t("forms.view_results") %>
        <%= icon(:chevron_right) %>
      <% end %>

      <% name = form.name.presence || t("forms.untitled") %>
      <%= form_with url: form_path(form), method: :delete, data: { turbo_confirm: t("forms.confirm_delete", name: name) } do %>
        <%= icon_button :trash, label: t("forms.delete_named", name: name), type: "submit", class: "hover:text-danger" %>
      <% end %>
    </div>
  </article>
<% end %>
